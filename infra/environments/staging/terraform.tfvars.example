# ==============================================================================
# Staging Environment - terraform.tfvars.example
# ==============================================================================

project_id  = "my-gcp-staging-project-id"
region      = "us-central1"
github_repo = "my-github-org/my-repository"

# Networking
subnet_cidr    = "10.10.0.0/20"
connector_cidr = "10.18.0.0/28"
immutable_tags = true

# Cloud SQL (PostgreSQL 16) - Production-Mirroring High Availability
db_version          = "POSTGRES_16"
db_tier             = "db-custom-1-3840"
db_availability_type = "REGIONAL"
db_disk_size        = 20
db_pitr_enabled     = true
db_retained_backups = 7
db_deletion_protection = true
db_name             = "app_db"
db_user             = "app_user"

# Cloud Run Services (Warm instances mirroring production)
api_image         = "us-docker.pkg.dev/cloudrun/container/hello"
api_min_instances = 1
api_max_instances = 5
api_cpu           = "1"
api_memory        = "512Mi"

web_image         = "us-docker.pkg.dev/cloudrun/container/hello"
web_min_instances = 1
web_max_instances = 5
web_cpu           = "1"
web_memory        = "512Mi"

worker_image         = "us-docker.pkg.dev/cloudrun/container/hello"
worker_min_instances = 1
worker_max_instances = 5
worker_cpu           = "1"
worker_memory        = "512Mi"
